---
const { frontmatter } = Astro.props;
import Analytics from "@vercel/analytics/astro";
import Meta from "../components/Meta.astro";
import { isoDate } from "../utils/pageMeta";
---

<html lang="en">
    <head>
        <Meta
            title={frontmatter.title}
            description={`Writing practice from ${new Date(frontmatter.date).toLocaleString()}`}
            type="article"
            publishedTime={isoDate(frontmatter.date)}
            noindex={frontmatter.ultraHidden}
        />
        <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/bitmaks/cm-web-fonts@latest/fonts.css">
        <Analytics />
    </head>
    <body>
        <main>
            <a href="/practice" class="back-button">← Back to Practice Sessions</a>
            <h1>{frontmatter.title}</h1>
            <small>{new Date(frontmatter.date).toLocaleString()}</small>
            <slot />
        </main>
    </body>
</html>


<style>
    body {
        background: #cccccc;
        color: #222222;
        margin: 40px;
        line-height: 1.5;
    }
    
    .back-button {
        display: inline-block;
        text-decoration: none;
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid transparent;
        transition: all 0.2s ease;
    }
    
    .back-button:hover {
        color: #222;
        border-bottom-color: #222;
    }
</style>