---
import TableOfContents from "../components/TableOfContents.astro";
import Default from "../layouts/Default.astro";
import { Content, getHeadings } from "./_useful.md";

const meta = {
    title: "Useful Content",
    description: "A list of useful links and stuff for various purposes",
};
---

<Default meta={meta}>
    <div class="page">
        <h1>
            Useful Content
        </h1>
        <strong>Please don't contact me to add things here...</strong> I am not very good at keeping track of them <br> I especially do not want to use this as your advertisement board, especially if it's some AI-generated shit that ISN'T at least as good (in many senses) as photocraft
        <TableOfContents headings={getHeadings()} />
        <Content />
    </div>
</Default>