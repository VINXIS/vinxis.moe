---
import TableOfContents from "../components/TableOfContents.astro";
import Default from "../layouts/Default.astro";
import { Content, getHeadings } from "./_useful.md";

const meta = {
    title: "Useful Content",
    description: "A list of useful links and stuff for various purposes",
};
---

<Default meta={meta}>
    <div class="page">
        <h1>
            Useful Content
        </h1>
        <TableOfContents headings={getHeadings()} />
        <Content />
    </div>
</Default>